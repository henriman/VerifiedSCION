// +gobra

package gopacket

import . "verification/utils/definitions"
import sl "verification/utils/slices"
import "verification/utils/seqs"

type SerializableLayer interface {
	pred Mem(ubuf []byte)

	// TODO[henri]: add TODO add hyper
	ghost
	requires Mem(ubuf)
	decreases
	pure IsLow(ghost ubuf []byte) bool

	// TODO: reorder?
	requires  !opts.FixLengths
	requires  b != nil && b.Mem()
	requires  sl.Bytes(b.UBuf(), 0, len(b.UBuf()))
	requires  Mem(ubuf) && IsLow(ubuf)
	requires  sl.Bytes(ubuf, 0, len(ubuf))
	// TODO: Once Gobra issue #846 is resolved, express this using `hyper` function.
	requires  low(len(ubuf)) && 
		forall i int :: { sl.GetByte(ubuf, 0, len(ubuf), i) } 0 <= i && i < len(ubuf) &&
			low(i) ==> low(sl.GetByte(ubuf, 0, len(ubuf), i))
	requires  low(opts.ComputeChecksums)
	// TODO[henri]: Might have introduced IsLow for this
	requires  low(len(b.UBuf())) && 
		forall i int :: { sl.GetByte(b.UBuf(), 0, len(b.UBuf()), i) } 0 <= i && i < len(b.UBuf()) &&
			low(i) ==> low(sl.GetByte(b.UBuf(), 0, len(b.UBuf()), i))
	ensures   sl.Bytes(ubuf, 0, len(ubuf))
	ensures   err == nil ==> (Mem(ubuf) && b.Mem())
	ensures   err == nil ==> sl.Bytes(b.UBuf(), 0, len(b.UBuf()))
	ensures   err != nil ==> err.ErrorMem()
	decreases
	SerializeTo(b SerializeBuffer, opts SerializeOptions, ghost ubuf []byte) (err error)

	pure
	decreases
	LayerType() LayerType
}

type SerializeOptions struct {
	FixLengths bool
	ComputeChecksums bool
}

type SerializeBuffer interface {
	pred Mem()

	ghost
	pure
	requires acc(Mem(), _)
	decreases
	UBuf() []byte

	ghost
	pure
	requires acc(Mem(), _)
	requires acc(sl.Bytes(UBuf(), 0, len(UBuf())), _)
	ensures  res == seqs.ToSeqByte(UBuf())
	decreases
	View() (ghost res seq[byte])

	preserves acc(Mem(), R50)
	ensures   res === UBuf()
	decreases
	Bytes() (res []byte)

	preserves Mem()
	requires  num >= 0
	preserves sl.Bytes(UBuf(), 0, len(UBuf()))
	ensures   err == nil ==> len(UBuf()) == len(old(UBuf())) + num
	ensures   err == nil ==> len(res) == num
	ensures   err == nil ==> res === UBuf()[:num]
	ensures   err == nil ==> old(View()) == View()[num:]
	ensures   err != nil ==> UBuf() === old(UBuf())
	ensures   err != nil ==> err.ErrorMem()
	// NOTE: I justified this by looking at the default implementation of 
	// SerializeBuffer which doesn't take into account the internal state
	// for success. however, we might want to
	// TODO[henri]: I think I would want to? at least add comment here
	ensures   low(num) ==> low(err != nil)
	// TODO[henri]: maybe turn into pre+post condition (then num needs to be there too)
	// TODO: Once Gobra issue #846 is resolved, express this using `hyper` function
	// (or using IsLow for UBuf?)
	ensures   err == nil && low(num) && (low(len(UBuf())) && 
		forall i int :: { sl.GetByte(UBuf(), 0, len(UBuf()), i) } 0 <= i && i < len(old(UBuf())) &&
			low(i) ==> low(old(sl.GetByte(UBuf(), 0, len(UBuf()), i)))) ==> 
		low(len(UBuf())) &&
			forall i int :: { sl.GetByte(UBuf(), 0, len(UBuf()), i) } num <= i && i < len(UBuf()) &&
				low(i) ==> low(sl.GetByte(UBuf(), 0, len(UBuf()), i))
	decreases
	PrependBytes(num int) (res []byte, err error)

	preserves Mem()
	requires  num >= 0
	preserves sl.Bytes(UBuf(), 0, len(UBuf()))
	ensures   err == nil ==> len(UBuf()) == len(old(UBuf())) + num
	ensures   err == nil ==> len(res) == num
	ensures   err == nil ==> res === UBuf()[len(UBuf()) - num:]
	ensures   err != nil ==> UBuf() === old(UBuf())
	ensures   err != nil ==> err.ErrorMem()
	decreases
	AppendBytes(num int) (res []byte, err error)

	preserves Mem()
	preserves sl.Bytes(UBuf(), 0, len(UBuf()))
	ensures   err != nil ==> err.ErrorMem()
	ensures   err == nil ==> len(UBuf()) == 0
	decreases
	Clear() (err error)

	requires false
	decreases
	Layers() (res []LayerType)

	requires false
	decreases
	PushLayer(LayerType)
}

ensures res != nil && res.Mem()
ensures sl.Bytes(res.UBuf(), 0, len(res.UBuf()))
decreases
func NewSerializeBuffer() (res SerializeBuffer)

// TODO: requires changes to provide access to the underlying layers
requires  false
requires  len(layerBufs) == len(layers)
preserves w.Mem()
preserves acc(layerBufs, R20)
preserves forall i int :: {&layers[i]} 0 <= i && i < len(layers) ==> acc(&layers[i]) && layers[i].Mem(layerBufs[i])
decreases
func SerializeLayers(w SerializeBuffer, opts SerializeOptions, ghost layerBufs []([]byte), layers ...SerializableLayer) error
