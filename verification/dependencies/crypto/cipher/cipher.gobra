// Package cipher implements standard block cipher modes that can be wrapped
// around low-level block cipher implementations.
// See https://csrc.nist.gov/groups/ST/toolkit/BCM/current_modes.html
// and NIST Special Publication 800-38A.

// Originally taken from https://cs.opensource.google/go/go/+/refs/tags/go1.19:src/crypto/cipher/cipher.go

// +gobra

package cipher

import . "github.com/scionproto/scion/verification/utils/definitions"
import sl "github.com/scionproto/scion/verification/utils/slices"

// A Block represents an implementation of block cipher
// using a given key. It provides the capability to encrypt
// or decrypt individual blocks. The mode implementations
// extend that capability to streams of blocks.
type Block interface {
	pred Mem()

	// TODO[DOC]
	// TODO: explain why this needs to be here considering it is not called in
	// interface methods (but used for something else, see implementations
	// of interface)
	// TODO: Once Gobra issue #955 is resolved, mark as `hyper`.
	ghost
	requires Mem()
	decreases
	pure IsLow() bool

	// BlockSize returns the cipher's block size.
	pure
	requires Mem()
	ensures  0 <= n
	decreases
	BlockSize() (n int)

	// Encrypt encrypts the first block in src into dst.
	// Dst and src must overlap entirely or not at all.
	preserves Mem()
	preserves sl.Bytes(dst, 0, len(dst))
	preserves acc(sl.Bytes(src, 0, len(src)), R10)
	decreases
	Encrypt(dst, src []byte)

	// Decrypt decrypts the first block in src into dst.
	// Dst and src must overlap entirely or not at all.
	preserves Mem()
	preserves sl.Bytes(dst, 0, len(dst))
	preserves acc(sl.Bytes(src, 0, len(src)), R10)
	decreases
	Decrypt(dst, src []byte)
}

// A Stream represents a stream cipher.
type Stream interface {
	pred Mem()

	// XORKeyStream XORs each byte in the given slice with a byte from the
	// cipher's key stream. Dst and src must overlap entirely or not at all.
	//
	// If len(dst) < len(src), XORKeyStream should panic. It is acceptable
	// to pass a dst bigger than src, and in that case, XORKeyStream will
	// only update dst[:len(src)] and will not touch the rest of dst.
	//
	// Multiple calls to XORKeyStream behave as if the concatenation of
	// the src buffers was passed in a single run. That is, Stream
	// maintains state and does not reset at each XORKeyStream call.
	requires  len(src) <= len(dst)
	preserves Mem()
	preserves sl.Bytes(dst, 0, len(dst))
	preserves acc(sl.Bytes(src, 0, len(src)), R10)
	decreases
	XORKeyStream(dst, src []byte)
}

// A BlockMode represents a block cipher running in a block-based mode (CBC,
// ECB etc).
type BlockMode interface {
	pred Mem()

	// TODO[DOC]
	// TODO: explain why this needs to be here (I mean it is used in CryptBlocks,
	// but this might be connected to Block interface)
	// TODO: Once Gobra issue #955 is resolved, mark as `hyper`.
	ghost
	requires Mem()
	decreases
	pure IsLow() bool

	// BlockSize returns the mode's block size.
	pure
	requires Mem()
	ensures  0 <= n
	decreases
	BlockSize() (n int)

	// CryptBlocks encrypts or decrypts a number of blocks. The length of
	// src must be a multiple of the block size. Dst and src must overlap
	// entirely or not at all.
	//
	// If len(dst) < len(src), CryptBlocks should panic. It is acceptable
	// to pass a dst bigger than src, and in that case, CryptBlocks will
	// only update dst[:len(src)] and will not touch the rest of dst.
	//
	// Multiple calls to CryptBlocks behave as if the concatenation of
	// the src buffers was passed in a single run. That is, BlockMode
	// maintains state and does not reset at each CryptBlocks call.
	// TODO[EPIC]
	// TODO: This contract might be too restrictive. What do I really need to know?
	// Do I need that dst is low, or only that its length is low?
	requires  len(src) <= len(dst)
	requires  acc(sl.Bytes(dst, 0, len(dst)), 1 - R10)
	requires  dst !== src ==> acc(sl.Bytes(dst, 0, len(dst)), R10)
	requires  acc(sl.Bytes(src, 0, len(src)), R10)
	requires  low(len(dst)) &&
		forall i int :: { sl.GetByte(dst, 0, len(dst), i) } 0 <= i && i < len(dst) &&
			low(i) ==> low(sl.GetByte(dst, 0, len(dst), i))
	requires  low(len(src)) &&
		forall i int :: { sl.GetByte(src, 0, len(src), i) } 0 <= i && i < len(src) &&
			low(i) ==> low(sl.GetByte(src, 0, len(src), i))
	preserves Mem() && IsLow()
	ensures   acc(sl.Bytes(dst, 0, len(dst)), 1 - R10)
	ensures   dst !== src ==> acc(sl.Bytes(dst, 0, len(dst)), R10)
	ensures   acc(sl.Bytes(src, 0, len(src)), R10)
	ensures   low(len(dst)) &&
		forall i int :: { sl.GetByte(dst, 0, len(dst), i) } 0 <= i && i < len(dst) &&
			low(i) ==> low(sl.GetByte(dst, 0, len(dst), i))
	ensures   BlockSize() == old(BlockSize())
	decreases
	CryptBlocks(dst, src []byte)
}
