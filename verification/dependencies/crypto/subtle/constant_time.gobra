// Signatures for the public declarations in file
// https://go.dev/src/crypto/subtle/constant_time.go

// +gobra

package subtle

import sl "github.com/scionproto/scion/verification/utils/slices"

// TODO[DOC]
// Add comment or NOTE[henri] regarding having changed this to non-pure
// TODO[CONST]
// TODO: might want to introduce the body here in order to be able to prove the 
// contract (see comment below)
// ConstantTimeCompare returns 1 if the two slices, x and y, have equal contents
// and 0 otherwise. The time taken is a function of the length of the slices and
// is independent of the contents.
// trusted
requires p > 0
requires acc(sl.Bytes(x, 0, len(x)), p)
requires low(len(x)) && 
    forall i int :: { sl.GetByte(x, 0, len(x), i) } 0 <= i && i < len(x) &&
        low(i) ==> low(sl.GetByte(x, 0, len(x), i))
requires acc(sl.Bytes(y, 0, len(y)), p)
requires low(len(y)) && 
    forall i int :: { sl.GetByte(y, 0, len(y), i) } 0 <= i && i < len(y) &&
        low(i) ==> low(sl.GetByte(y, 0, len(y), i))
ensures  acc(sl.Bytes(x, 0, len(x)), p) && acc(sl.Bytes(y, 0, len(y)), p)
ensures  len(x) != len(y) ==> res == 0
ensures  low(res)
decreases
func ConstantTimeCompare(x, y []byte, ghost p perm) (res int)

