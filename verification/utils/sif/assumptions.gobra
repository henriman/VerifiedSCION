// +gobra

package sif

import (
    "crypto/subtle"
    sl "github.com/scionproto/scion/verification/utils/slices"
)

// TODO: Once Gobra issue #832 is resolved, introduce body and prove this.
ghost
requires p > 0 && acc(b, p)
requires low(len(b)) && forall i int :: { &b[i] } 0 <= i && i < len(b) && low(i) ==> low(b[i])
ensures  acc(b, p) && low(string(b))
decreases
func AssumeLowSliceToLowString(b []byte, p perm)

// TODO: This is a remnant of the old attempt at verifying `pkg/experimental/epic`.
// Using the annotations of `subtle.ConstantTimeCompare` from 
// sif-pkg-experimental-epic one should be able to remove this assumption.
ghost
requires p > 0 && acc(sl.Bytes(x, 0, len(x)), p) && acc(sl.Bytes(y, 0, len(y)), p)
requires low(len(x)) && low(len(y))
requires forall i int :: { sl.GetByte(x, 0, len(x), i) } 0 <= i && i < len(x) ==>
    low(sl.GetByte(x, 0, len(x), i))
requires forall i int :: { sl.GetByte(y, 0, len(y), i) } 0 <= i && i < len(y) ==>
    low(sl.GetByte(y, 0, len(y), i))
ensures  acc(sl.Bytes(x, 0, len(x)), p) && acc(sl.Bytes(y, 0, len(y)), p)
ensures  low(subtle.ConstantTimeCompare(x, y))
decreases
func LowSlicesImplyLowConstantTimeCompare(x, y []byte, p perm)
