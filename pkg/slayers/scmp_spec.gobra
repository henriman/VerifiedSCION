// +gobra

package slayers

import (
	"github.com/google/gopacket"

	. "github.com/scionproto/scion/verification/utils/definitions"
	sl "github.com/scionproto/scion/verification/utils/slices"
	"github.com/scionproto/scion/pkg/addr"
)

pred (s *SCMP) NonInitMem() {
	acc(&s.TypeCode) &&
	acc(&s.Checksum) &&
	acc(&s.BaseLayer) &&
	acc(&s.scn) &&
	(s.scn != nil ==> s.scn.ChecksumMem())
}

pred (s *SCMP) Mem(ub []byte) {
	acc(&s.TypeCode) &&
	acc(&s.Checksum) &&
	s.BaseLayer.Mem(ub, 4) &&
	acc(&s.scn) &&
	(s.scn != nil ==> s.scn.ChecksumMem())
}

ghost
requires  init ==> s.Mem(ub)
requires !init ==> s.NonInitMem()
decreases
pure func (s *SCMP) GetTypeCode(init bool, ghost ub []byte) SCMPTypeCode {
	return init ? (unfolding s.Mem(ub) in s.TypeCode) : (unfolding s.NonInitMem() in s.TypeCode)
}

ghost
requires  init ==> s.Mem(ub)
requires !init ==> s.NonInitMem()
decreases
pure func (s *SCMP) GetScn(init bool, ghost ub []byte) *SCION {
	return init ? (unfolding s.Mem(ub) in s.scn) : (unfolding s.NonInitMem() in s.scn)
}

requires s.Mem(ub) && s.GetScn(true, ub) != nil
decreases
pure func (s *SCMP) GetScnRawSrcAddrLen(ghost ub []byte) int {
	return unfolding s.Mem(ub) in 
		unfolding s.scn.ChecksumMem() in len(s.scn.RawSrcAddr)
}

requires s.Mem(ub) && s.GetScn(true, ub) != nil
requires 0 <= i && i < s.GetScnRawSrcAddrLen(ub)
decreases
pure func (s *SCMP) GetScnRawSrcAddrByte(ghost ub []byte, i int) byte {
	return unfolding s.Mem(ub) in 
		unfolding s.scn.ChecksumMem() in sl.GetByte(s.scn.RawSrcAddr, 0, len(s.scn.RawSrcAddr), i)
}

requires s.Mem(ub) && s.GetScn(true, ub) != nil
decreases
pure func (s *SCMP) GetScnRawDstAddrLen(ghost ub []byte) int {
	return unfolding s.Mem(ub) in 
		unfolding s.scn.ChecksumMem() in len(s.scn.RawDstAddr)
}

requires s.Mem(ub) && s.GetScn(true, ub) != nil
requires 0 <= i && i < s.GetScnRawDstAddrLen(ub)
decreases
pure func (s *SCMP) GetScnRawDstAddrByte(ghost ub []byte, i int) byte {
	return unfolding s.Mem(ub) in 
		unfolding s.scn.ChecksumMem() in sl.GetByte(s.scn.RawDstAddr, 0, len(s.scn.RawDstAddr), i)
}

requires s.Mem(ub) && s.GetScn(true, ub) != nil
decreases
pure func (s *SCMP) GetScnSrcIA(ghost ub []byte) addr.IA {
	return unfolding s.Mem(ub) in 
		unfolding s.scn.ChecksumMem() in s.scn.SrcIA
}

requires s.Mem(ub) && s.GetScn(true, ub) != nil
decreases
pure func (s *SCMP) GetScnDstIA(ghost ub []byte) addr.IA {
	return unfolding s.Mem(ub) in 
		unfolding s.scn.ChecksumMem() in s.scn.DstIA
}

// NOTE[henri]: We need to define IsLowDecodingLayer (for gopacket.DecodingLayer)
// /and/ IsLow (for gopacket.SerializableLayer).

// TODO[henri]: might want to instead have IsLow->IsLowSerializableLayer and
// IsLowDecodingLayer->IsLow bc. for DecodingLayer we have the more modular 
// version (with init bool) which should be taken as the base.
// - we have a similar situation in scion_spec oÄ

// TODO: Once Gobra issue #846 is resolved, actually implement `IsLowDecodingLayer`.
ghost
trusted
requires  init ==> s.Mem(ub)
requires !init ==> s.NonInitMem()
decreases
pure func (s *SCMP) IsLowDecodingLayer(init bool, ghost ub []byte) bool

ghost
requires s.Mem(ub)
decreases
pure func (s *SCMP) IsLow(ghost ub []byte) bool {
	return s.IsLowDecodingLayer(true, ub)
}

// "Reveal the body" of `s.IsLowDecodingLayer` (necessary bc. we can't implement 
// `s.IsLowDecodingLayer` yet).
// TODO: Once Gobra issue #846 is resolved, implement this.
ghost
trusted
requires p > 0
requires  init ==> acc(s.Mem(ub), p)
requires !init ==> acc(s.NonInitMem(), p)
requires s.IsLowDecodingLayer(init, ub)
ensures   init ==> acc(s.Mem(ub), p)
ensures  !init ==> acc(s.NonInitMem(), p)
ensures  low(s.GetTypeCode(init, ub)) && low(s.GetScn(init, ub) != nil)
// TODO[henri]: could make these more general
ensures  init ==> s.GetScn(true, ub) != nil ==> low(s.GetScnRawSrcAddrLen(ub)) &&
	forall i int :: { s.GetScnRawSrcAddrByte(ub, i) } 0 <= i && i < s.GetScnRawSrcAddrLen(ub) &&
		low(i) ==> low(s.GetScnRawSrcAddrByte(ub, i))
ensures  init ==> s.GetScn(true, ub) != nil ==> low(s.GetScnRawDstAddrLen(ub)) &&
	forall i int :: { s.GetScnRawDstAddrByte(ub, i) } 0 <= i && i < s.GetScnRawDstAddrLen(ub) &&
		low(i) ==> low(s.GetScnRawDstAddrByte(ub, i))
ensures  init ==> s.GetScn(true, ub) != nil ==> low(s.GetScnSrcIA(ub)) && low(s.GetScnDstIA(ub))
decreases
func (s *SCMP) RevealIsLowDecodingLayer(init bool, ghost ub []byte, p perm)

// Assert `s.IsLowDecodingLayer` (necessary bc. we can't implement 
// `s.IsLowDecodingLayer` yet).
// TODO: Once Gobra issue #846 is resolved, implement this.
ghost
trusted
requires p > 0
requires  init ==> acc(s.Mem(ub), p)
requires !init ==> acc(s.NonInitMem(), p)
requires low(s.GetTypeCode(init, ub)) && low(s.GetScn(init, ub) != nil)
requires init ==> s.GetScn(true, ub) != nil ==> low(s.GetScnRawSrcAddrLen(ub)) &&
	forall i int :: { s.GetScnRawSrcAddrByte(ub, i) } 0 <= i && i < s.GetScnRawSrcAddrLen(ub) &&
		low(i) ==> low(s.GetScnRawSrcAddrByte(ub, i))
requires init ==> s.GetScn(true, ub) != nil ==> low(s.GetScnRawDstAddrLen(ub)) &&
	forall i int :: { s.GetScnRawDstAddrByte(ub, i) } 0 <= i && i < s.GetScnRawDstAddrLen(ub) &&
		low(i) ==> low(s.GetScnRawDstAddrByte(ub, i))
requires init ==> s.GetScn(true, ub) != nil ==> low(s.GetScnSrcIA(ub)) && low(s.GetScnDstIA(ub))
ensures   init ==> acc(s.Mem(ub), p)
ensures  !init ==> acc(s.NonInitMem(), p)
ensures  s.IsLowDecodingLayer(init, ub)
decreases
func (s *SCMP) AssertIsLow(init bool, ghost ub []byte, p perm)

ghost
requires s.Mem(ub)
ensures  s.NonInitMem()
decreases
func (s *SCMP) DowngradePerm(ghost ub []byte) {
	unfold s.Mem(ub)
	unfold s.BaseLayer.Mem(ub, 4)
	fold s.NonInitMem()
}

requires false
func (b *SCMP) LayerContents() (res []byte) {
	res = b.BaseLayer.LayerContents()
	return res
}

preserves acc(b.Mem(ub), R20)
ensures   0 <= start && start <= end && end <= len(ub)
ensures   len(res) == end - start
ensures   res === ub[start:end]
decreases
func (b *SCMP) LayerPayload(ghost ub []byte) (res []byte, ghost start int, ghost end int) {
	unfold acc(b.Mem(ub), R20)
	res = b.BaseLayer.LayerPayload(ub, 4)
	start = 4
	end = len(ub)
	fold acc(b.Mem(ub), R20)
	return res, start, end
}

(*SCMP) implements gopacket.Layer
(*SCMP) implements gopacket.SerializableLayer
(*SCMP) implements gopacket.DecodingLayer
